generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  name        String
  xp          Int      @default(0)
  reputation  String   @default("Novice")
  level       String   @default("Beginner")
  avatar      String?
  submissions Submission[]
}

model Challenge {
  id                  String   @id @default(uuid())
  title               String
  description         String
  category            String
  status              String   @default("Open")
  difficulty          String
  xpReward            Int
  prize               String
  deadline            DateTime
  maxParticipants     Int
  currentParticipants Int      @default(0)
  founderName         String
  founderAvatar       String
  companyName         String
  requirements        String   // JSON string or comma-separated
  createdAt           DateTime @default(now())
  scoringCriteria     ScoringCriterion[]
  submissions         Submission[]
}

model ScoringCriterion {
  id          String    @id @default(uuid())
  name        String
  weight      Int
  description String
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model Submission {
  id           String    @id @default(uuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  talentName   String
  talentAvatar String
  submittedAt  DateTime  @default(now())
  status       String    @default("Pending")
  score        Int?
  summary      String
  link         String
}
