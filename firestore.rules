rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isPro() {
      return getUserData().subscriptionTier == 'pro';
    }

    function isFounder() {
      return isAuthenticated() && getUserData().role == 'founder';
    }

    function isSubmissionChallengeFounder(submission) {
      return isFounder() &&
        get(/databases/$(database)/documents/challenges/$(submission.challengeId)).data.founderId == request.auth.uid;
    }

    function isMessageParticipant(messageData) {
      return isAuthenticated() &&
        (messageData.founderId == request.auth.uid || messageData.builderId == request.auth.uid);
    }

    function isValidMessageSender(messageData) {
      return isMessageParticipant(messageData) &&
        messageData.senderId == request.auth.uid &&
        messageData.senderRole == getUserData().role;
    }
    
    function isDev() {
      return isAuthenticated() && request.auth.token.email.endsWith('@entrext.com');
    }

    // Challenges Collection
    match /challenges/{challengeId} {
      // Anyone can view challenges
      allow read: if true;
      
      // Only founders can create challenges
      // Starter Founders: Limited to 1 challenge
      // Pro Founders: Unlimited
      allow create: if isAuthenticated() && 
                    getUserData().role == 'founder' && 
                    (isPro() || (
                      !('challengeCount' in getUserData()) || 
                      getUserData().challengeCount < 1
                    ));
      
      // Basic update for metadata, incrementing participants
      allow update: if isAuthenticated();
      
      // Respect deletion restriction, but allow devs for testing
      allow delete: if isDev();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      // Anyone can view submissions (public proof profiles)
      allow read: if true;
      
      // Only talent can submit
      // Starter Builders: Limited to 2 submissions
      // Pro Builders: Unlimited
      allow create: if isAuthenticated() && 
                    getUserData().role == 'talent' && 
                    (isPro() || (
                      !('submissionCount' in getUserData()) || 
                      getUserData().submissionCount < 2
                    ));
      
      // Talent can update their own submission.
      // Founder who owns the challenge can only update review fields.
      allow update: if isAuthenticated() && (
                    isOwner(resource.data.talentId) ||
                    (
                      isSubmissionChallengeFounder(resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'feedback'])
                    )
                  );
      
      // Allow devs to delete for testing
      allow delete: if isDev();
    }

    // Users Collection
    match /users/{userId} {
      // Public profile view
      allow read: if true;
      
      // Users can only write to their own profile
      // Protection: Users cannot change their own subscriptionTier or role once set.
      // This ensures pro status is only granted via the payment webhook.
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId) && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionTier', 'role']));
    }
    
    // Direct Messages (Founder Pro / Builder Pro Feature)
    match /messages/{messageId} {
      // Founders and builders can only access their own message threads.
      allow read: if isAuthenticated() && isMessageParticipant(resource.data);
      allow create: if isAuthenticated() && isValidMessageSender(request.resource.data);
      allow update, delete: if false;
    }

    // Manual Payout Tracking
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() &&
                  (isPro() || resource.data.founderId == request.auth.uid || resource.data.builderId == request.auth.uid);

      allow create: if isAuthenticated() &&
                    getUserData().role == 'founder' &&
                    request.resource.data.founderId == request.auth.uid;

      allow update: if isAuthenticated() &&
                    getUserData().role == 'founder' &&
                    resource.data.founderId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'transferReference', 'payoutNotes', 'paidAt']);

      allow delete: if isDev();
    }
  }
}
